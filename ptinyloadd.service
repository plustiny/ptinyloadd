[Unit]
Description=Download tool for Remote Server.
Requires=nftables.service
After=nftables.service
After=network.target

[Service]
LoadCredential=privkey.pem:/etc/letsencrypt/live/(your.server)/privkey.pem
LoadCredential=fullchain.pem:/etc/letsencrypt/live/(your.server)/fullchain.pem
EnvironmentFile=/usr/local/etc/ptinyloadd/ptinyloadd.conf
User=ptinyload
Group=share
UMask=002
ExecStart=/usr/local/bin/ptinyloadd
KillMode=mixed
Restart=always

# more harden
InaccessiblePaths=/home
NoNewPrivileges=yes
# PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectHome=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
CapabilityBoundingSet=~CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
